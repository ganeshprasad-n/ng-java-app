# Temp files
*.tmp
*.temp
.tmp/

# Environment files
.env
.env.local
.env.prod
.env.dev

# Application properties (optional - remove if you want to track these)
# application.properties
# application-*.properties

# Backup files (EXCEPT README.md.bak - we want to keep this)
*.bak
!README.md.bak
*.backup
*.old

# ElasticSearch data
data/elasticsearch/

# MySQL data
/var/lib/mysql/

# RabbitMQ data
/var/lib/rabbitmq/

# Memcached data (if any)

# Tomcat work directory
/opt/tomcat9/work/

# Scripts backup (if any)
scripts/*.bak

# Exceptions - files we DO want to track
!.gitkeep
!README.md.bak# Maven
